{
  "manifest_version": 3,
  "name": "Forms I Answered",
  "version": "0.4.0",
  "description": "Lists the Google Forms you have opened or submitted, and whether each is still open. Chrome and Edge can share one list through your own Google Drive.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "history",
    "storage",
    "webNavigation",
    "alarms",
    "identity"
  ],
  "host_permissions": [
    "https://docs.google.com/*",
    "https://www.googleapis.com/*",
    "https://oauth2.googleapis.com/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Forms I Answered",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  }
}
