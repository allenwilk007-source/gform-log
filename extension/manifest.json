{
  "manifest_version": 3,
  "name": "Forms I Answered",
  "version": "0.3.0",
  "description": "Lists the Google Forms you have opened or submitted, from this browser's history and from now on, synced across your desktop browsers.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "history",
    "storage",
    "webNavigation",
    "alarms"
  ],
  "host_permissions": [
    "https://docs.google.com/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Forms I Answered",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  }
}
